# Flutter·Android·iOS 소셜 설정의 단일 로컬 원본.
# 이 파일을 .env로 복사한 뒤 `sh tool/generate_ios_env.sh`를 실행한다.
# 카카오만 먼저 쓸 때는 KAKAO_NATIVE_APP_KEY만 채워도 생성할 수 있다.
# 실제 키는 커밋하거나 채팅에 붙이지 않는다.
# 값에 공백이 없는 키는 따옴표 없이 KEY=value 형식으로 입력한다.

# iOS Simulator는 localhost, 실기기는 개발 Mac의 LAN IP를 사용한다.
API_BASE_URL=http://localhost:8080/api
TOUR_API_KEY=your_tour_api_service_key

KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key

# 네이버 로그인 (네이버 개발자 콘솔 → 애플리케이션 등록 후 발급)
# Android manifest placeholder로도 주입됨 (build.gradle.kts resolveConfig)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CLIENT_NAME=가보자GO
NAVER_URL_SCHEME=gabojagonaver

# 구글 로그인. iOS 값도 같은 .env에서 iOS 설정 파일로 생성한다.
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.your_ios_client_id
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

**/.dart_tool/
**/.flutter-plugins-dependencies
**/.flutter-plugins
**/devtools_options.yaml
.pub-cache/
.pub/

# Xcode / Swift Package Manager 캐시
**/swiftpm/
**/*.xcworkspace/xcshareddata/swiftpm/

# 루트 실수 방지: flutter create가 루트에서 실행돼도 추적 안 됨
/android/
/ios/
/linux/
/macos/
/windows/

# Environment 파일 (민감한 정보: API 키, DB 자격증명 등)
**/.env
**/.env.local
# 더는 실행에 사용하지 않지만, 기존 개인 파일이 실수로 추적되지 않도록 유지한다.
**/.env.imac
**/.env.tailscale
**/.env.*.local
**/ios/Flutter/Env.xcconfig

# Build outputs
**/build/
**/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
gabojago-frontend/android/app/debug
gabojago-frontend/android/app/profile
gabojago-frontend/android/app/release

# Backend
